# Para onde o servidor de desenvolvimento repassa /api/*.
#
# Não é VITE_*: o valor é lido pelo vite.config.ts e usado só no proxy do dev
# server, nunca entra no bundle. A URL da API em produção fica no rewrite do
# vercel.json, então mudá-la não exige mais rebuild do frontend.
#
# Só precisa definir se sua API local não estiver na porta padrão.
API_PROXY_TARGET=https://localhost:7106
